FROM golang:1.24-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/roomworker ./cmd/roomworker

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home game

WORKDIR /app

COPY --from=build --chown=game:game /out/roomworker ./roomworker

USER game

EXPOSE 8081

ENTRYPOINT ["./roomworker"]
